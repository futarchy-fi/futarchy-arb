# systemd --user unit for the multi-option arb bot on Robinhood Chain (4663). Installed on farol as
# ~/.config/systemd/user/nvda-multi-arb-bot.service
[Unit]
Description=Multi-option futarchy arb bot: NVDA next CEO market (Robinhood Chain 4663)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/futarchy-fi/futarchy-arb
# Holds only PRIVATE_KEY_NVDA_ROBINHOOD (the operator key of the arb contracts: gas only). Mode 600.
EnvironmentFile=%h/.config/arb-bots/nvda-robinhood.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# ethers is the only dependency; it lives outside the repo so the bot does not need the Hardhat toolchain.
Environment=NODE_PATH=%h/.local/share/nvda-robinhood-arb/node_modules
Environment=CONFIRM=true
Environment=ARB_CONTRACT_ADDRESS=0x355281efa67e0daf09c5f50206c0d957b8fff2a8
Environment=MARKET_ID=0
Environment=OPTION_NAMES=BUCK,HAAS,SROUJI,KRESS,JENSEN,NONE,OTHER
# farol cannot reach rpc.mainnet.chain.robinhood.com (connection refused), so publicnode goes first.
Environment=ROBINHOOD_RPC_URLS=https://robinhood-rpc.publicnode.com,https://rpc.mainnet.chain.robinhood.com
Environment=SCAN_INTERVAL_MS=5000
Environment=MIN_NET_PROFIT=0.5
Environment=MAX_COMPANY_PER_TRADE=10
Environment=MAX_CURRENCY_PER_TRADE=500
Environment=HEARTBEAT_FILE=%h/shared/nvda-multi-arb-heartbeat.json
Environment=TRADE_LOG_FILE=%h/data/arb-logs/nvda-multi-arb-trades.jsonl
Environment=ALERT_CMD=%h/.local/bin/general-status-send
ExecStartPre=/bin/mkdir -p %h/data/arb-logs
ExecStart=%h/.local/bin/node scripts/arb-bot-multi-option.js
# The user journal on farol is not readable, so the log goes to a file.
StandardOutput=append:%h/data/arb-logs/nvda-multi-arb-bot.log
StandardError=append:%h/data/arb-logs/nvda-multi-arb-bot.log
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
